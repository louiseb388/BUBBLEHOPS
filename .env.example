# Stripe (test keys to start — swap for live keys when you go live)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# https://dashboard.stripe.com/webhooks — used by app/api/webhook/route.ts
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL, used for Stripe success/cancel redirects and SEO canonical/OG tags
NEXT_PUBLIC_SITE_URL=https://bubblehops.co.uk

# Supabase inventory (optional — falls back to the seed table in lib/data.ts
# if not set, exactly like the original inventory.js behaviour)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_INVENTORY_TABLE=inventory
