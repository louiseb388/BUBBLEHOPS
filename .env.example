# Stripe (test keys to start — swap for live keys when you go live)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# https://dashboard.stripe.com/webhooks — used by app/api/webhook/route.ts
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL, used for Stripe success/cancel redirects, SEO canonical/OG tags, and the
# sender address for Brevo emails below (noreply@<this hostname>) — keep it on the bare
# domain (no "www"), since www.bubblehops.com redirects to it and Stripe won't follow
# redirects when calling the webhook.
NEXT_PUBLIC_SITE_URL=https://bubblehops.com

# Supabase — powers sign-in (email magic link), saved designs, order history and
# (optionally) live inventory. Falls back gracefully with everything unset: sign-in shows
# a "not configured yet" message, and stock falls back to the seed table in lib/data.ts.
# Setup: create a project at supabase.com, run supabase/schema.sql in its SQL editor, then
# copy these two from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_INVENTORY_TABLE=inventory
# Service-role key (Project Settings → API) — server-only, used by app/api/webhook/route.ts
# to log paid orders and by app/api/admin/orders (order status + finished-pair photo
# uploads) to read/write across every customer's orders. Never prefix with NEXT_PUBLIC_
# or expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (brevo.com) — sends the contact form to SITE.email (lib/data.ts); a "New order"
# email to that same address plus an order-confirmation and painting/photo-ready email
# to the customer once a Stripe webhook fires or /admin updates an order's status.
# Without this set, all of the above are just logged server-side instead of emailed.
# Uses Brevo's Transactional Email API — the same account/verified sending domain
# already set up for Supabase's auth emails (see supabase/schema.sql), so no separate
# provider or domain verification is needed. Generate this under Brevo → SMTP & API →
# API Keys (a different credential from the SMTP key used for Supabase's auth emails).
BREVO_API_KEY=

# The email you'll sign in with to use /admin (set an order's status, upload the
# finished-pair photo). Whoever's signed in with this exact email — case-insensitive —
# gets access; everyone else gets a 403 from app/api/admin/orders.
ADMIN_EMAIL=
